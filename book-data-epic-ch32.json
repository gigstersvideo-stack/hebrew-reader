: "Юваль перестал тереть деталь и посмотрел на него внимательно.", "words": [{"t": "יוּבַל", "lemma": "יוּבַל", "root": "—", "pos": "имя собств.", "tr": "Юваль", "extra": ""}, {"t": "חָדַל", "lemma": "חָדַל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְשַׁפְשֵׁף", "lemma": "לְשַׁפְשֵׁף", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַחֵלֶק", "lemma": "הַחֵלֶק", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְהִסְתַּכֵּל", "lemma": "וְהִסְתַּכֵּל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בּוֹ", "lemma": "בּוֹ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּתְשׁוּמֶת", "lemma": "בְּתְשׁוּמֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֵב.", "lemma": "לֵב", "root": "—", "pos": "имя собств.", "tr": "Лев", "extra": ""}]}, {"id": "s13", "literal": "", "fluent": "— Это значит, что она умеет ждать разрешения, — сказал он.", "words": [{"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "זֶה", "lemma": "זֶה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹמֵר", "lemma": "אוֹמֵר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁהִיא", "lemma": "שֶׁהִיא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יוֹדַעַת", "lemma": "יוֹדַעַת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְהַמְתִּין", "lemma": "לְהַמְתִּין", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְאִשּׁוּר,", "lemma": "לְאִשּׁוּר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אָמַר.", "lemma": "אָמַר", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s14", "literal": "", "fluent": "— Или что она не враг, который ломает двери, — ответил Нир. — А гость, который ждёт приглашения.", "words": [{"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹ", "lemma": "אוֹ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁהִיא", "lemma": "שֶׁהִיא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹיֵב", "lemma": "אוֹיֵב", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁשּׁוֹבֵר", "lemma": "שֶׁשּׁוֹבֵר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "דְּלָתוֹת,", "lemma": "דְּלָתוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָנָה", "lemma": "עָנָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נִיר.", "lemma": "נִיר", "root": "—", "pos": "имя собств.", "tr": "Нир", "extra": ""}, {"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶלָּא", "lemma": "אֶלָּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹרֵחַ", "lemma": "אוֹרֵחַ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁמַּמְתִּין", "lemma": "שֶׁמַּמְתִּין", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְהַזְמָנָה.", "lemma": "לְהַזְמָנָה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s15", "literal": "", "fluent": "— Все стены, которые нас учат строить, — для защиты от врага, — сказал Юваль медленно. — А что, если враг — не то слово?", "words": [{"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "כָּל", "lemma": "כָּל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַקִּירוֹת", "lemma": "הַקִּירוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁמְּלַמְּדִים", "lemma": "שֶׁמְּלַמְּדִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹתָנוּ", "lemma": "אוֹתָנוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לִבְנוֹת", "lemma": "לִבְנוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְהָגֵן", "lemma": "לְהָגֵן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מֵאוֹיֵב,", "lemma": "מֵאוֹיֵב", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אָמַר", "lemma": "אָמַר", "root": "—", "pos": "", "tr": ""