", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלְּךָ,", "lemma": "שֶׁל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אַתָּה", "lemma": "אַתָּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שָׁמַעְתָּ", "lemma": "שָׁמַעְתָּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַזִּיכְרוֹנוֹת", "lemma": "הַזִּיכְרוֹנוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלִּי.\"", "lemma": "שֶׁל", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s16", "literal": "", "fluent": "«Это страннее всего, что случалось со мной в шахте», — признался Итай.", "words": [{"t": "\"זֶה", "lemma": "זֶה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מוּזָר", "lemma": "מוּזָר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יוֹתֵר", "lemma": "יוֹתֵר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מִכָּל", "lemma": "מִכָּל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "דָּבָר", "lemma": "דָּבָר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁקָּרָה", "lemma": "שֶׁקָּרָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בַּמִּכְרֶה,\"", "lemma": "בַּמִּכְרֶה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הוֹדָה", "lemma": "הוֹדָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אִיתַי.", "lemma": "אִיתַי", "root": "—", "pos": "имя собств.", "tr": "Итай", "extra": ""}]}, {"id": "s17", "literal": "", "fluent": "«Мы всё ещё не подходим друг другу», — сказала Шира, но на этот раз без холода в голосе.", "words": [{"t": "\"אֲנַחְנוּ", "lemma": "אֲנַחְנוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עֲדַיִן", "lemma": "עֲדַיִן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מַתְאִימִים,\"", "lemma": "מַתְאִימִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אָמְרָה", "lemma": "אָמְרָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שִׁירָה,", "lemma": "שִׁירָה", "root": "—", "pos": "имя собств.", "tr": "Шира", "extra": ""}, {"t": "אֲבָל", "lemma": "אֲבָל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּלִי", "lemma": "בְּלִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "קֹר", "lemma": "קֹר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בַּקּוֹל", "lemma": "בַּקּוֹל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַפַּעַם.", "lemma": "הַפַּעַם", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s18", "literal": "", "fluent": "«Может, и нет. Но мы всё ещё здесь», — ответил Итай.", "words": [{"t": "\"אוּלַי", "lemma": "אוּלַי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא.", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֲבָל", "lemma": "אֲבָל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֲנַחְנוּ", "lemma": "אֲנַחְנוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עֲדַיִן", "lemma": "עֲדַיִן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "כָּאן,\"", "lemma": "כָּאן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָנָה", "lemma": "עָנָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אִיתַי.", "lemma": "אִיתַי", "root": "—", "pos": "имя собств.", "tr": "Итай", "extra": ""}]}, {"id": "s19", "literal": "", "fluent": "Они долго сидели молча, глядя, как внизу один за другим загораются огни Рубежа.", "words": [{"t": "הֵם", "lemma": "הֵם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יָשְׁבוּ", "lemma": "יָשְׁבוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּשֶׁקֶט", "lemma": "בְּשֶׁקֶט", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "זְמַן", "lemma": "זְמַן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "רַב,", "lemma": "רַב", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מַבִּיטִים", "lemma": "מַבִּיטִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t":