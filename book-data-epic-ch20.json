{"title": "Итоги месяца", "sentences": [{"id": "s1", "literal": "", "fluent": "На доске объявлений висел новый список, и курсанты молча собрались перед ним.", "words": [{"t": "עַל", "lemma": "עַל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לוּחַ", "lemma": "לוּחַ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַמּוֹדָעוֹת", "lemma": "הַמּוֹדָעוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הֵרֵי", "lemma": "הֵרֵי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָיְיתָה", "lemma": "הָיְיתָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "תָּלוּיָה", "lemma": "תָּלוּיָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "רְשִׁימָה", "lemma": "רְשִׁימָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "חֲדָשָׁה,", "lemma": "חֲדָשָׁה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְקַדֵּטִים", "lemma": "וְקַדֵּטִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הִתְאַסְּפוּ", "lemma": "הִתְאַסְּפוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מוּלָהּ", "lemma": "מוּל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בִּדְמָמָה.", "lemma": "בִּדְמָמָה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s2", "literal": "", "fluent": "Три имени были отмечены красным, а рядом — слово «отчислен».", "words": [{"t": "שְׁלוֹשָׁה", "lemma": "שְׁלוֹשָׁה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֵׁמוֹת", "lemma": "שֵׁמוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָיוּ", "lemma": "הָיוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מְסֻמָּנִים", "lemma": "מְסֻמָּנִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּאָדֹם,", "lemma": "בְּאָדֹם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְלִידָם", "lemma": "וְלִידָם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַמִּלָּה", "lemma": "הַמִּלָּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "\"שֻׁחְרָר.\"", "lemma": "שֻׁחְרָר", "root": "—