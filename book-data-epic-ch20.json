tr": "", "extra": ""}, {"t": "הַפַּעַם.", "lemma": "הַפַּעַם", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s11", "literal": "", "fluent": "«Стена» кивнул и попытался улыбнуться. — «Береги себя от своего командира. Он похож на того, кто не прощает легко».", "words": [{"t": "\"הַקִּיר\"", "lemma": "הַקִּיר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הִנְהֵן,", "lemma": "הִנְהֵן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְנֶאֱבַק", "lemma": "וְנֶאֱבַק", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְחַיֵּיךְ.", "lemma": "לְחַיֵּיךְ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "\"תִּזָּהֵר", "lemma": "תִּזָּהֵר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מֵהַמְּפַקֵּד", "lemma": "מֵהַמְּפַקֵּד", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלְּךָ.", "lemma": "שֶׁל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הוּא", "lemma": "הוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נִרְאָה", "lemma": "נִרְאָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "כְּמוֹ", "lemma": "כְּמוֹ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מִישֶׁהוּ", "lemma": "מִישֶׁהוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלֹּא", "lemma": "שֶׁלֹּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "סוֹלֵחַ", "lemma": "סוֹלֵחַ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּקַלּוּת.\"", "lemma": "בְּקַלּוּת", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s12", "literal": "", "fluent": "«Он в порядке, когда его узнаёшь», — ответил Гиль, хотя сам не был в этом уверен.", "words": [{"t": "\"הוּא", "lemma": "הוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּסֵדֶר,", "lemma": "בְּסֵדֶר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "כְּשֶׁמַּכִּירִים", "lemma": "כְּשֶׁמַּכִּירִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹתוֹ,\"", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}