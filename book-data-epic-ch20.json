: "הָרְשִׁימָה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s5", "literal": "", "fluent": "Среди уходящих был «Стена», парень с первого шаттла, не прошедший медосмотр.", "words": [{"t": "בֵּין", "lemma": "בֵּין", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַיּוֹצְאִים", "lemma": "הַיּוֹצְאִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָיָה", "lemma": "הָיָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "\"הַקִּיר,\"", "lemma": "הַקִּיר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַבָּחוּר", "lemma": "הַבָּחוּר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מֵהַמַּעְבּוֹרֶת", "lemma": "מֵהַמַּעְבּוֹרֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָרִאשׁוֹנָה,", "lemma": "הָרִאשׁוֹנָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלֹּא", "lemma": "שֶׁלֹּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָבַר", "lemma": "עָבַר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַבְּדִיקָה", "lemma": "הַבְּדִיקָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָרְפוּאִית.", "lemma": "הָרְפוּאִית", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s6", "literal": "", "fluent": "Он вернулся на день собрать вещи, и лицо его было старше его возраста.", "words": [{"t": "הוּא", "lemma": "הוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "חָזַר", "lemma": "חָזַר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְיוֹם", "lemma": "לְיוֹם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶחָד", "lemma": "אֶחָד", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֶאֱסֹף", "lemma": "לֶאֱסֹף", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "חֲפָצִים,", "lemma": "חֲפָצִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וּפָנָיו", "lemma": "וּפָנָיו", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָיוּ", "lemma": "הָיוּ",