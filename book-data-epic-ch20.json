": "הָרְשִׁימָה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s5", "literal": "", "fluent": "Позади Нади крепко обняла Гиля, потому что его имени тоже не было.", "words": [{"t": "מֵאָחוֹר,", "lemma": "מֵאָחוֹר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נָדִי", "lemma": "נָדִי", "root": "—", "pos": "имя собств.", "tr": "Нади", "extra": ""}, {"t": "חִבְּקָה", "lemma": "חִבְּקָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "גִּיל", "lemma": "גִּיל", "root": "—", "pos": "имя собств.", "tr": "Гиль", "extra": ""}, {"t": "בְּחָזְקָה,", "lemma": "בְּחָזְקָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "כִּי", "lemma": "כִּי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "גַּם", "lemma": "גַּם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שְׁמוֹ", "lemma": "שְׁמוֹ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הוֹפִיעַ.", "lemma": "הוֹפִיעַ", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s6", "literal": "", "fluent": "«Видишь? Ещё не избавились от меня», — сказал Гиль с дрожащей улыбкой.", "words": [{"t": "\"רָאִית?", "lemma": "רָאִית", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עוֹד", "lemma": "עוֹד", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נִפְטְרוּ", "lemma": "נִפְטְרוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מִמֶּנִּי,\"", "lemma": "מִן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אָמַר", "lemma": "אָמַר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "גִּיל", "lemma": "גִּיל", "root": "—", "pos": "имя собств.", "tr": "Гиль", "extra": ""}, {"t": "בְּחִיּוּךְ", "lemma": "בְּחִיּוּךְ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "רוֹעֵד.", "lemma": "רוֹעֵד", "root": "—", "pos": "", "