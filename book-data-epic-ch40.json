": "", "tr": "", "extra": ""}, {"t": "אוֹתָך.", "lemma": "אוֹתָך", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s9", "literal": "", "fluent": "— Барак, что ты делаешь? — её голос дрогнул.", "words": [{"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בָּרָק,", "lemma": "בָּרָק", "root": "—", "pos": "имя собств.", "tr": "Барак", "extra": ""}, {"t": "מָה", "lemma": "מָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אַתָּה", "lemma": "אַתָּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עוֹשֶׂה?", "lemma": "עוֹשֶׂה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "קוֹלָהּ", "lemma": "קוֹלָהּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "רָעַד.", "lemma": "רָעַד", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s10", "literal": "", "fluent": "— То, что должен был сделать тридцать лет назад вместо того, чтобы прятаться, — ответил он.", "words": [{"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מָה", "lemma": "מָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁהָיִיתִי", "lemma": "שֶׁהָיִיתִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "צָרִיך", "lemma": "צָרִיך", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לַעֲשׂוֹת", "lemma": "לַעֲשׂוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לִפְנֵי", "lemma": "לִפְנֵי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שְׁלוֹשִׁים", "lemma": "שְׁלוֹשִׁים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שָׁנָה", "lemma": "שָׁנָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בִּמְקוֹם", "lemma": "בִּמְקוֹם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְהִתְחַבֵּא,", "lemma": "לְהִתְחַבֵּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָנָה.", "lemma": "עָנָה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s11", "literal": "", "fluent": "Он направил свой ярем в самый узкий участок прохода, туда, где Трал не