: "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "כָּאן", "lemma": "כָּאן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֵין", "lemma": "אֵין", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹפֶק,", "lemma": "אוֹפֶק", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אָמַר", "lemma": "אָמַר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אִיתַי", "lemma": "אִיתַי", "root": "—", "pos": "имя собств.", "tr": "Итай", "extra": ""}, {"t": "בְּשֶׁקֶט.", "lemma": "בְּשֶׁקֶט", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s6", "literal": "", "fluent": "— Есть, — ответил Рами. — Просто он движется вместе с городом.", "words": [{"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יֵשׁ,", "lemma": "יֵשׁ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָנָה", "lemma": "עָנָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "רָמִי.", "lemma": "רָמִי", "root": "—", "pos": "имя собств.", "tr": "Рами", "extra": ""}, {"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "פָּשׁוּט", "lemma": "פָּשׁוּט", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הוּא", "lemma": "הוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "זָז", "lemma": "זָז", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עִם", "lemma": "עִם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָעִיר.", "lemma": "הָעִיר", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s7", "literal": "", "fluent": "Итай поднял голову к одному из парусов — огромному, поворачивающемуся медленно, как живое существо.", "words": [{"t": "אִיתַי", "lemma": "אִיתַי", "root": "—", "pos": "имя собств.", "tr": "Итай", "extra": ""}, {"t": "הֵרִים", "lemma": "הֵרִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "רֹאשׁ", "lemma": "רֹאשׁ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְאֶחָד", "lemma": "לְאֶחָד", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "ה