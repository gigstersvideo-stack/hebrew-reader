{"title": "Разбор", "sentences": [{"id": "s1", "literal": "", "fluent": "Барак сидел перед экраном в пустом кабинете и пытался написать рапорт в третий раз.", "words": [{"t": "בָּרָק", "lemma": "בָּרָק", "root": "—", "pos": "имя собств.", "tr": "Барак", "extra": ""}, {"t": "יָשַׁב", "lemma": "יָשַׁב", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מוּל", "lemma": "מוּל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַמָּסָךְ", "lemma": "הַמָּסָךְ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בַּמִּשְׂרָד", "lemma": "בַּמִּשְׂרָד", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָרֵיק", "lemma": "הָרֵיק", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְנִסָּה", "lemma": "וְנִסָּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לִכְתֹּב", "lemma": "לִכְתֹּב", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַדּוּ״חַ", "lemma": "הַדּוּחַ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּפַעַם", "lemma": "בְּפַעַם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַשְּׁלִישִׁית.", "lemma": "הַשְּׁלִישִׁית", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s2", "literal": "", "fluent": "Слова «Каток слушал небо» выглядели ему неверными каждый раз, когда он их писал.", "words": [{"t": "הַמִּלִּים", "lemma": "הַמִּלִּים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "\"הַמַּכְבֵּשׁ", "lemma": "הַמַּכְבֵּשׁ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הִקְשִׁיב", "lemma": "הִקְשִׁיב", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לַשָּׁמַיִם\"", "lemma": "לַשָּׁמַיִם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נִרְאוּ", "lemma": "נִרְאוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לוֹ", "lemma": "לוֹ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שְׁגוּיוֹת", "lemma": "שְׁגוּיוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּכָל", "lemma": "בְּכָל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "פַּעַם", "lemma": "פַּעַם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁהוּא", "lemma": "שֶׁהוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "כָּתַב", "lemma": "כָּתַב", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹתָן.", "lemma": "אוֹתָן", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s3", "literal": "", "fluent": "Он стёр их и написал вместо этого: «Нетипичное поведение животного, неопасное».", "words": [{"t": "הוּא", "lemma": "הוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מָחַק", "lemma": "מָחַק", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹתָן", "lemma": "אוֹתָן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְכָתַב", "lemma": "וְכָתַב", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בִּמְקוֹמָן:", "lemma": "בִּמְקוֹמָן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "\"הִתְנַהֲגוּת", "lemma": "הִתְנַהֲגוּת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "חַיָּה", "lemma": "חַיָּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "חֲרִיגָה,", "lemma": "חֲרִיגָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מְסֻכֶּנֶת.\"", "lemma": "מְסֻכֶּנֶת", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s4", "literal": "", "fluent": "Это было верно и неверно в равной мере.", "words": [{"t": "זֶה", "lemma": "זֶה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָיָה", "lemma": "הָיָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נָכוֹן", "lemma": "נָכוֹן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְלֹא", "lemma": "וְלֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נָכוֹן", "lemma": "נָכוֹן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּאוֹתָהּ", "lemma": "בְּאוֹתָהּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מִדָּה.", "lemma": "מִדָּה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s5", "literal": "", "fluent": "Дверь кабинета открылась без стука, и вошла майор Дрор с папкой в руке.", "words": [{"t": "דֶּלֶת", "lemma": "דֶּלֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַמִּשְׂרָד", "lemma": "הַמִּשְׂרָד", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נִפְתְּחָה", "lemma": "נִפְתְּחָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּלִי", "lemma": "בְּלִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "דְּפִיקָה,", "lemma": "דְּפִיקָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וּמֵיֶּרֶת", "lemma": "וּמֵיֶּרֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "דְּרוֹר", "lemma": "דְּרוֹר", "root": "—", "pos": "имя собств.", "tr": "Дрор", "extra": ""}, {"t": "נִכְנְסָה,", "lemma": "נִכְנְסָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "תִּיקִיָּה", "lemma": "תִּיקִיָּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בַּיָּד.", "lemma": "בַּיָּד", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s6", "literal": "", "fluent": "«Я прочла твой рапорт», — сказала она без приветствия.", "words": [{"t": "\"קָרָאתִי", "lemma": "קָרָאתִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַדּוּ״חַ", "lemma": "הַדּוּחַ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלְּךָ,\"", "lemma": "שֶׁלְּךָ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הִיא", "lemma": "הִיא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אָמְרָה,", "lemma": "אָמְרָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּלִי", "lemma": "בְּלִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בֶּרֶכָה.", "lemma": "בֶּרֶכָה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s7", "literal": "", "fluent": "«И?»", "words": [{"t": "\"וְ?\"", "lemma": "וְ", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s8", "literal": "", "fluent": "«И он красивый и короткий, и не вызовет никаких вопросов».", "words": [{"t": "\"וְהוּא", "lemma": "וְהוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יָפֶה", "lemma": "יָפֶה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְקָצָר,", "lemma": "וְקָצָר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְלֹא", "lemma": "וְלֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יַעֲלֶה", "lemma": "יַעֲלֶה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שׁוּם", "lemma": "שׁוּם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שְׁאֵלָה.\"", "lemma": "שְׁאֵלָה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s9", "literal": "", "fluent": "«Это не было моим намерением».", "words": [{"t": "\"זֶה", "lemma": "זֶה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָיָה", "lemma": "הָיָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַכַּוָּנָה", "lemma": "הַכַּוָּנָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלִּי.\"", "lemma": "שֶׁלִּי", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s10", "literal": "", "fluent": "«Я знаю, — ответила Дрор. — И всё же это результат. Не проси курсантов задавать вопросы о Катке».", "words": [{"t": "\"אֲנִי", "lemma": "אֲנִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יוֹדַעַת,\"", "lemma": "יוֹדַעַת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָנְתָה", "lemma": "עָנְתָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "דְּרוֹר.", "lemma": "דְּרוֹר", "root": "—", "pos": "имя собств.", "tr": "Дрор", "extra": ""}, {"t": "\"בְּכָל", "lemma": "בְּכָל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "זֹאת,", "lemma": "זֹאת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "זוֹ", "lemma": "זוֹ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַתּוֹצָאָה.", "lemma": "הַתּוֹצָאָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אַל", "lemma": "אַל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "תְּבַקֵּשׁ", "lemma": "תְּבַקֵּשׁ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מֵהַקַּדֵּטִים", "lemma": "מֵהַקַּדֵּטִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שְׁאֵלוֹת", "lemma": "שְׁאֵלוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עַל", "lemma": "עַל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַמַּכְבֵּשׁ.\"", "lemma": "הַמַּכְבֵּשׁ", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s11", "literal": "", "fluent": "«Кармель уже задаёт вопросы».", "words": [{"t": "\"קַרְמֶל", "lemma": "קַרְמֶל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "כְּבָר", "lemma": "כְּבָר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שׁוֹאֶלֶת", "lemma": "שׁוֹאֶלֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שְׁאֵלוֹת.\"", "lemma": "שְׁאֵלוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s12", "literal": "", "fluent": "«Тогда останови её», — сказала Дрор и ушла, больше ничего не объясняя.", "words": [{"t": "\"אָז", "lemma": "אָז", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "תַּעֲצֹר", "lemma": "תַּעֲצֹר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אוֹתָהּ,\"", "lemma": "אוֹתָהּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אָמְרָה", "lemma": "אָמְרָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "דְּרוֹר,", "lemma": "דְּרוֹר", "root": "—", "pos": "имя собств.", "tr": "Дрор", "extra": ""}, {"t": "וְעָזְבָה", "lemma": "וְעָזְבָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּלִי", "lemma": "בְּלִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְהַסְבִּיר", "lemma": "לְהַסְבִּיר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עוֹד.", "lemma": "עוֹד", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s13", "literal": "", "fluent": "Барак нашёл Цахи