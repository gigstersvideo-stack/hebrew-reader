 "extra": ""}, {"t": "שֶׁהִגָּה", "lemma": "שֶׁהִגָּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַמִּלָּה.", "lemma": "הַמִּלָּה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s15", "literal": "", "fluent": "Прорыв остановили за четыре секунды до условной границы — рекорд, который не попал в официальный протокол, потому что никто не считал три Копья одной командой достаточно долго, чтобы придумать графу для этого результата.", "words": [{"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַפְּרִיצָה", "lemma": "הַפְּרִיצָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָצְרוּ", "lemma": "עָצְרוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אַרְבַּע", "lemma": "אַרְבַּע", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שְׁנִיּוֹת", "lemma": "שְׁנִיּוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לִפְנֵי", "lemma": "לִפְנֵי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַגְּבוּל", "lemma": "הַגְּבוּל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַמּוֹסְכָּם", "lemma": "הַמּוֹסְכָּם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שִׂיא", "lemma": "שִׂיא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלֹּא", "lemma": "שֶׁלֹּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נִכְנַס", "lemma": "נִכְנַס", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לַפְּרוֹטוֹקוֹל", "lemma": "לַפְּרוֹטוֹקוֹל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָרִשְׁמִי,", "lemma": "הָרִשְׁמִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "כִּי", "lemma": "כִּי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אִישׁ", "lemma": "אִישׁ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}