"", "tr": "", "extra": ""}, {"t": "וְלֹא", "lemma": "וְלֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שָׁאַל", "lemma": "שָׁאַל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שְׁאֵלוֹת", "lemma": "שְׁאֵלוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נוֹסָפוֹת.", "lemma": "נוֹסָפוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s20", "literal": "", "fluent": "«Отдохните сегодня оба, — сказал он. — Завтра продолжим».", "words": [{"t": "\"תָּנוּחוּ", "lemma": "תָּנוּחוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שְׁנֵיכֶם", "lemma": "שְׁנֵיכֶם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַיּוֹם,\"", "lemma": "הַיּוֹם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הוּא", "lemma": "הוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אָמַר.", "lemma": "אָמַר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "\"מָחָר", "lemma": "מָחָר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נַמְשִׁיךְ.\"", "lemma": "נַמְשִׁיךְ", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s21", "literal": "", "fluent": "Когда все ушли, Шира осталась сидеть одна в пустой кабине.", "words": [{"t": "כְּשֶׁכֻּלָּם", "lemma": "כְּשֶׁכֻּלָּם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָזְבוּ,", "lemma": "עָזְבוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שִׁירָה", "lemma": "שִׁירָה", "root": "—", "pos": "имя собств.", "tr": "Шира", "extra": ""}, {"t": "נִשְׁאֲרָה", "lemma": "נִשְׁאֲרָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יוֹשֶׁבֶת", "lemma": "יוֹשֶׁבֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְבַדָּהּ", "lemma": "לְבַדָּהּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בַּתָּא", "lemma": "בַּתָּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָרֵיק.", "lemma": "הָרֵיק", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s22", "literal": "", "fluent": "Итай остановился в дверях, не увере