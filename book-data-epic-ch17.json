 "pos": "", "tr": "", "extra": ""}, {"t": "בְּכֹחַ", "lemma": "בְּכֹחַ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלֹּא", "lemma": "שֶׁלֹּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יָדְעָה", "lemma": "יָדְעָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁיֵּשׁ", "lemma": "שֶׁיֵּשׁ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לָהּ,", "lemma": "לְ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְאִיתַי", "lemma": "וְאִיתַי", "root": "—", "pos": "имя собств.", "tr": "и Итай", "extra": ""}, {"t": "נִזְרַק", "lemma": "נִזְרַק", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַחוּצָה", "lemma": "הַחוּצָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מֵהַתֶּפֶר.", "lemma": "מֵהַתֶּפֶר", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s17", "literal": "", "fluent": "Он тяжело дышал, и глаза его были широко открыты от потрясения.", "words": [{"t": "הוּא", "lemma": "הוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נָשַׁם", "lemma": "נָשַׁם", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּכֹבֶד,", "lemma": "בְּכֹבֶד", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְעֵינָיו", "lemma": "וְעֵינָיו", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָיוּ", "lemma": "הָיוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "פְּתוּחוֹת", "lemma": "פְּתוּחוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּתַדְהֵמָה.", "lemma": "בְּתַדְהֵמָה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s18", "literal": "", "fluent": "«Не смей, — крикнула Шира, и голос её дрожал. — Не смей об этом говорить».", "words": [{"t": "\"אַל", "lemma": "אַל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "תָּעֵז,\"", "lemma": "תָּעֵז", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "צָעֲקָה", "lemma": "צָעֲקָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שִׁירָה,", "lemma": "שִׁירָה", "root": "—", "pos": "имя собств.", "tr": "Шира", "extra": ""}, {"t": "וְקוֹלָהּ", "lemma": "וְקוֹלָהּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "רָעַד.", "lemma": "רָעַד", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "\"אַל", "lemma": "אַל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "תָּעֵז", "lemma": "תָּעֵז", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְדַבֵּר", "lemma": "לְדַבֵּר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עַל", "lemma": "עַל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "זֶה.\"", "lemma": "זֶה", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s19", "literal": "", "fluent": "«Я не хотел…»", "words": [{"t": "\"לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הִתְכַּוַּנְתִּי—\"", "lemma": "הִתְכַּוַּנְתִּי", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s20", "literal": "", "fluent": "«Мне всё равно, что ты хотел!» — крикнула она, и слёзы стояли у неё в глазах, не падая.", "words": [{"t": "\"לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אִכְפַּת", "lemma": "אִכְפַּת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לִי", "lemma": "לְ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מָה", "lemma": "מָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הִתְכַּוַּנְתָּ!\"", "lemma": "הִתְכַּוַּנְתָּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הִיא", "lemma": "הִיא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "צָעֲקָה,", "lemma": "צָעֲקָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְהַדְּמָעוֹת", "lemma": "וְהַדְּמָעוֹת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָמְדוּ", "lemma": "עָמְדוּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בָּעֵינַיִים", "lemma": "בָּעֵינַיִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלָּהּ", "lemma": "שֶׁל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּלִי", "lemma": "בְּלִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לִפֹּל.", "lemma": "לִפֹּל", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s21", "literal": "", "fluent": "Итай не пытался подойти. Он просто стоял, руки опущены, ожидая, пока пройдёт буря.", "words": [{"t": "אִיתַי", "lemma": "אִיתַי", "root": "—", "pos": "имя собств.", "tr": "Итай", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "נִסָּה", "lemma": "נִסָּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְהִתְקָרֵב.", "lemma": "לְהִתְקָרֵב", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הוּא", "lemma": "הוּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "רַק", "lemma": "רַק", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָמַד,", "lemma": "עָמַד", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יָדַיִים", "lemma": "יָדַיִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְמַטָּה,", "lemma": "לְמַטָּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מְחַכֶּה", "lemma": "מְחַכֶּה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁהַסַּעַר", "lemma": "שֶׁהַסַּעַר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "יַעֲבֹר.", "lemma": "יַעֲבֹר", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s22", "literal": "", "fluent": "«Я никому не расскажу», — сказал он наконец, тихо. — «Клянусь».", "words": [{"t": "\"אֲנִי", "lemma": "אֲנִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֲסַפֵּר", "lemma": "אֲסַפֵּר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְאִישׁ,\"", "lemma": "לְאִישׁ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אָמַר", "lemma": "אָמַר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּסוֹף,", "lemma": "בְּסוֹף", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּשֶׁקֶט.", "lemma": "בְּשֶׁקֶט", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": 