": "גַּלְגַּלִּים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "פָּנִים", "lemma": "פָּנִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שֶׁלֹּא", "lemma": "שֶׁלֹּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "זָזִים.", "lemma": "זָזִים", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s13", "literal": "", "fluent": "«Папа», — непроизвольно прошептала Шира внутри шва.", "words": [{"t": "\"אַבָּא,\"", "lemma": "אַבָּא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לָחְשָׁה", "lemma": "לָחְשָׁה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שִׁירָה", "lemma": "שִׁירָה", "root": "—", "pos": "имя собств.", "tr": "Шира", "extra": ""}, {"t": "בְּתוֹךְ", "lemma": "בְּתוֹךְ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַתֶּפֶר,", "lemma": "הַתֶּפֶר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בְּלִי", "lemma": "בְּלִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לְהִתְכַּוֵּן.", "lemma": "לְהִתְכַּוֵּן", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s14", "literal": "", "fluent": "Комната в воспоминании была слишком белой и чистой, а на стене висел знак высокого звания.", "words": [{"t": "הַחֶדֶר", "lemma": "הַחֶדֶר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בַּזִּכָּרוֹן", "lemma": "בַּזִּכָּרוֹן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הָיָה", "lemma": "הָיָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לָבָן", "lemma": "לָבָן", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְנָקִי", "lemma": "וְנָקִי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "מִדַּי,", "lemma": "מִדַּי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְעַל", "lemma": "וְעַל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַקִּיר", "lemma": "הַקִּיר", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "תָּלוּי", "lemma": "תָּלוּי", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "תַּג", "lemma": "תַּג", "