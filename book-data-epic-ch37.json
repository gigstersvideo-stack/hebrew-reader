, "pos": "", "tr": "", "extra": ""}, {"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַקְּרִיאָה?", "lemma": "הַקְּרִיאָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שָׁאֲלָה", "lemma": "שָׁאֲלָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לִיאָת.", "lemma": "לִיאָת", "root": "—", "pos": "имя собств.", "tr": "Лиат", "extra": ""}]}, {"id": "s7", "literal": "", "fluent": "— Слышат, — ответила Тиква. — И, кажется, отвечают ему телом, а не голосом.", "words": [{"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "שׁוֹמְעִים,", "lemma": "שׁוֹמְעִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עָנְתָה", "lemma": "עָנְתָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "תִּקְוָה.", "lemma": "תִּקְוָה", "root": "—", "pos": "имя собств.", "tr": "Тиква", "extra": ""}, {"t": "—", "lemma": "—", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "וְכַנִּרְאֶה", "lemma": "וְכַנִּרְאֶה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "עוֹנִים", "lemma": "עוֹנִים", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לָהּ", "lemma": "לָהּ", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בַּגּוּף,", "lemma": "בַּגּוּף", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "לֹא", "lemma": "לֹא", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "בַּקּוֹל.", "lemma": "בַּקּוֹל", "root": "—", "pos": "", "tr": "", "extra": ""}]}, {"id": "s8", "literal": "", "fluent": "Тиква включила динамик прибора и проиграла запись зова, записанную на Пустоши.", "words": [{"t": "תִּקְוָה", "lemma": "תִּקְוָה", "root": "—", "pos": "имя собств.", "tr": "Тиква", "extra": ""}, {"t": "הִדְלִיקָה", "lemma": "הִדְלִיקָה", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "אֶת", "lemma": "אֶת", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "רַמְקוֹל", "lemma": "רַמְקוֹל", "root": "—", "pos": "", "tr": "", "extra": ""}, {"t": "הַמַּכְשִׁיר", "lemma": "הַמַּכְשִׁיר", "